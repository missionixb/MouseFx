<Window x:Class="MouseFx.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼠标特效设置" Width="380" Height="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FAFAFA">
    <StackPanel Margin="20,16,20,16">
        <!-- 特效开关 -->
        <TextBlock Text="特效开关" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
        <TextBlock Text="开关即时生效" Foreground="#888" FontSize="11" Margin="0,0,0,8"/>
        <CheckBox x:Name="RippleToggle" Content="点击波纹" Margin="0,0,0,4"/>
        <CheckBox x:Name="GlowToggle" Content="常驻光晕" Margin="0,0,0,4"/>
        <CheckBox x:Name="SparkToggle" Content="火花（鼠标火星粒子）" Margin="0,0,0,4"/>
        <CheckBox x:Name="AutoStartToggle" Content="开机自启动" Margin="0,0,0,0"/>
        <Separator Margin="0,14,0,12"/>

        <TextBlock Text="特效参数" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
        <TextBlock Text="拖动滑块即时生效并自动保存" Foreground="#888" FontSize="11" Margin="0,0,0,10"/>

        <!-- 主题颜色 -->
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="主题颜色" VerticalAlignment="Center"/>
                <Rectangle x:Name="ColorPreview" Width="18" Height="18" RadiusX="3" RadiusY="3"
                           Stroke="#999" Margin="8,0,0,0"/>
            </StackPanel>
            <Slider x:Name="HueSlider" Grid.Column="1" Minimum="0" Maximum="360" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
            <TextBlock x:Name="HueValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- 光圈大小 -->
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="光圈大小" VerticalAlignment="Center"/>
            <Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="10" Maximum="120" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
            <TextBlock x:Name="RadiusValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- 光圈不透明度 -->
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="光圈不透明度" VerticalAlignment="Center"/>
            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.05" Maximum="1"
                    SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
            <TextBlock x:Name="OpacityValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- 点击扩散大小 -->
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="点击扩散大小" VerticalAlignment="Center"/>
            <Slider x:Name="RippleSlider" Grid.Column="1" Minimum="20" Maximum="150" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
            <TextBlock x:Name="RippleValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- 扩散形状 -->
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="扩散形状" VerticalAlignment="Center"/>
            <ComboBox x:Name="RippleShapeBox" Grid.Column="1" Margin="0,0,8,0" Padding="4,2"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="圆圈"/>
                <ComboBoxItem Content="爱心"/>
                <ComboBoxItem Content="星星"/>
            </ComboBox>
        </Grid>

        <!-- 跟随速度 -->
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="跟随速度" VerticalAlignment="Center"/>
            <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="10" Maximum="200" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
            <TextBlock x:Name="SpeedValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </StackPanel>
</Window>
