<ui:FluentWindow x:Class="MouseFx.Settings.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Str.SettingsTitle}" Width="412"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
                 ShowInTaskbar="False"
                 FontFamily="{StaticResource Font.App}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Str.SettingsTitle}"
                     Icon="pack://application:,,,/app.ico"
                     ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="20,4,20,20">
            <!-- 头部：图标 + 应用名 + 标语 -->
            <StackPanel Orientation="Horizontal" Margin="4,4,0,16">
                <Image Source="pack://application:,,,/app.ico" Width="36" Height="36"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.AppName}" Style="{StaticResource AppTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Tagline}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 通用设置：与模式无关的全局项 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.General}" Style="{StaticResource SectionTitle}"/>

                    <!-- 开关行 -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.IdleFade}" Style="{StaticResource RowLabel}"/>
                        <ui:ToggleSwitch x:Name="IdleFadeToggle" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.HideFullscreen}" Style="{StaticResource RowLabel}"/>
                        <ui:ToggleSwitch x:Name="FullscreenToggle" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.AutoStart}" Style="{StaticResource RowLabel}"/>
                        <ui:ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 渲染帧率（全局，与模式无关） -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.RenderFps}" Style="{StaticResource RowLabel}"/>
                        <Slider x:Name="FpsSlider" Grid.Column="1" Minimum="30" Maximum="144" IsMoveToPointEnabled="True"/>
                        <TextBlock x:Name="FpsValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                    </Grid>

                    <!-- 界面语言（选项用各自原生名，不随语言翻译） -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.Language}" Style="{StaticResource RowLabel}"/>
                        <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="120" SelectedIndex="0">
                            <ComboBoxItem Content="中文"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 特效模式 + 当前模式的参数（切换模式，参数区就地更换） -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Mode}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.ModeHint}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>

                    <!-- 分段选择器：项由 EffectModeRegistry 驱动，新增模式自动出现 -->
                    <Border Background="{DynamicResource Bg.SubtleBrush}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="3" Margin="0,12,0,0">
                        <ItemsControl x:Name="ModeSelector" Loaded="ModeSelector_Loaded">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="Mode" Content="{Binding DisplayName}" Tag="{Binding}"
                                                 Style="{StaticResource SegmentItem}" Click="ModeItem_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 光圈参数 -->
                    <StackPanel x:Name="ClassicPanel">
                        <Border Height="1" Background="{DynamicResource Stroke.DividerBrush}" Margin="0,14,0,0"/>
                        <TextBlock Text="{DynamicResource Str.Panel.Halo}" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.Color}" Style="{StaticResource RowLabel}"/>
                                <Rectangle x:Name="ColorPreview" Width="16" Height="16" RadiusX="4" RadiusY="4"
                                           Stroke="{DynamicResource Stroke.CardBrush}" StrokeThickness="1" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Slider x:Name="HueSlider" Grid.Column="1" Minimum="0" Maximum="360" IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="HueValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.ClickShape}" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="RippleShapeBox" Grid.Column="1" Margin="0,0,8,0">
                                <ComboBoxItem Content="{DynamicResource Str.Shape.Circle}"/>
                                <ComboBoxItem Content="{DynamicResource Str.Shape.Heart}"/>
                                <ComboBoxItem Content="{DynamicResource Str.Shape.Star}"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.ClickRipple}" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch x:Name="RippleClickToggle" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.HaloSize}" Style="{StaticResource RowLabel}"/>
                            <Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="10" Maximum="120" IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="RadiusValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.HaloOpacity}" Style="{StaticResource RowLabel}"/>
                            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.05" Maximum="1"
                                    SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="OpacityValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.RippleSize}" Style="{StaticResource RowLabel}"/>
                            <Slider x:Name="RippleSlider" Grid.Column="1" Minimum="20" Maximum="150" IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="RippleValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.FollowSpeed}" Style="{StaticResource RowLabel}"/>
                            <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="10" Maximum="200" IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="SpeedValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <ui:Button x:Name="ClassicResetButton" Content="{DynamicResource Str.ResetDefaults}" Appearance="Secondary"
                                   HorizontalAlignment="Right" Margin="0,14,0,0"/>
                    </StackPanel>

                    <!-- 火屑参数 -->
                    <StackPanel x:Name="SparkPanel" Visibility="Collapsed">
                        <Border Height="1" Background="{DynamicResource Stroke.DividerBrush}" Margin="0,14,0,0"/>
                        <TextBlock Text="{DynamicResource Str.Panel.Spark}" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.Color}" Style="{StaticResource RowLabel}"/>
                                <Rectangle x:Name="SparkColorPreview" Width="16" Height="16" RadiusX="4" RadiusY="4"
                                           Stroke="{DynamicResource Stroke.CardBrush}" StrokeThickness="1" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Slider x:Name="SparkHueSlider" Grid.Column="1" Minimum="0" Maximum="360" IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="SparkHueValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.ParticleCount}" Style="{StaticResource RowLabel}"/>
                            <Slider x:Name="SparkCountSlider" Grid.Column="1" Minimum="50" Maximum="600" IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="SparkCountValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.LifeTime}" Style="{StaticResource RowLabel}"/>
                            <Slider x:Name="SparkLifeSlider" Grid.Column="1" Minimum="0.4" Maximum="2.5"
                                    SmallChange="0.1" IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="SparkLifeValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.ClickBurst}" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch x:Name="SparkBurstToggle" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>

                        <ui:Button x:Name="SparkResetButton" Content="{DynamicResource Str.ResetDefaults}" Appearance="Secondary"
                                   HorizontalAlignment="Right" Margin="0,14,0,0"/>
                    </StackPanel>

                    <!-- 烟花参数 -->
                    <StackPanel x:Name="SparklerPanel" Visibility="Collapsed">
                        <Border Height="1" Background="{DynamicResource Stroke.DividerBrush}" Margin="0,14,0,0"/>
                        <TextBlock Text="{DynamicResource Str.Panel.Sparkler}" Style="{StaticResource SectionTitle}" Margin="0,12,0,0"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.ParticleCount}" Style="{StaticResource RowLabel}"/>
                            <Slider x:Name="SparklerCountSlider" Grid.Column="1" Minimum="100" Maximum="800" IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="SparklerCountValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.StarSize}" Style="{StaticResource RowLabel}"/>
                            <Slider x:Name="SparklerSizeSlider" Grid.Column="1" Minimum="30" Maximum="300" IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="SparklerSizeValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.ClickBurst}" Style="{StaticResource RowLabel}"/>
                            <ui:ToggleSwitch x:Name="SparklerBurstToggle" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>

                        <ui:Button x:Name="SparklerResetButton" Content="{DynamicResource Str.ResetDefaults}" Appearance="Secondary"
                                   HorizontalAlignment="Right" Margin="0,14,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
