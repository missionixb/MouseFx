<Window x:Class="MouseFx.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="萤火鼠设置" Icon="pack://application:,,,/app.ico" Width="412"
        SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Background="#F4F5F7"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- ==== 基调 ==== -->
        <SolidColorBrush x:Key="Accent" Color="#3A7BFD"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E6E7EB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1C1C21"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#86868B"/>
        <SolidColorBrush x:Key="TrackRest" Color="#E3E4E8"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ==== 滑块：细轨 + 白底蓝环圆钮，左半轨显示主题色填充 ==== -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource Accent}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource TrackRest}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="White"
                                 Stroke="{StaticResource Accent}" StrokeThickness="2.5">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.25"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== 开关：现代滑动开关（替代复选框） ==== -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="12" Background="#D9DADF"/>
                            <Grid x:Name="Knob" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Grid.RenderTransform>
                                <Ellipse Width="18" Height="18" Fill="White">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Knob" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="18"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== 分段选择器（替代模式下拉框） ==== -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#5F5F65"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="0,7">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="Cp" Property="TextBlock.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== 按钮：白底描边，悬停微灰 ==== -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="White" Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F1F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E7E8EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18,20,20">
        <!-- 头部：图标 + 应用名 + 标语 -->
        <StackPanel Orientation="Horizontal" Margin="2,0,0,2">
            <Image Source="pack://application:,,,/app.ico" Width="34" Height="34" VerticalAlignment="Center"/>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="萤火鼠" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="鼠标划过，随手生光" Style="{StaticResource Secondary}" Margin="0,1,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 特效模式 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="特效模式" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="同一时间使用一种" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>

                <Border Background="#ECEDEF" CornerRadius="10" Padding="3" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="ModeClassic" Style="{StaticResource Segment}" GroupName="Mode" Content="光圈"/>
                        <RadioButton x:Name="ModeSpark" Style="{StaticResource Segment}" GroupName="Mode" Content="火屑" Grid.Column="1" Margin="3,0,0,0"/>
                        <RadioButton x:Name="ModeSparkler" Style="{StaticResource Segment}" GroupName="Mode" Content="烟花" Grid.Column="2" Margin="3,0,0,0"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="ModeDescription" Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                <!-- 三个开关行 -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="静止时淡出" Style="{StaticResource RowLabel}"/>
                        <TextBlock Text="鼠标停下 2 秒后，特效缓缓隐去" Style="{StaticResource Secondary}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="IdleFadeToggle" Style="{StaticResource Switch}" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="全屏时隐藏" Style="{StaticResource RowLabel}"/>
                        <TextBlock Text="玩游戏、看全屏画面时不打扰" Style="{StaticResource Secondary}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="FullscreenToggle" Style="{StaticResource Switch}" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="开机自启" Style="{StaticResource RowLabel}"/>
                        <TextBlock Text="登录 Windows 后自动运行" Style="{StaticResource Secondary}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="AutoStartToggle" Style="{StaticResource Switch}" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 光圈参数 -->
        <Border x:Name="ClassicPanel" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="光圈参数" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="拖动滑块立即生效，自动保存" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>

                <!-- 颜色 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="颜色" Style="{StaticResource RowLabel}"/>
                        <Rectangle x:Name="ColorPreview" Width="16" Height="16" RadiusX="4" RadiusY="4"
                                   Stroke="#D0D1D5" Margin="7,0,0,0"/>
                    </StackPanel>
                    <Slider x:Name="HueSlider" Grid.Column="1" Minimum="0" Maximum="360" Style="{StaticResource ModernSlider}"/>
                    <TextBlock x:Name="HueValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <!-- 点击形状 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="点击形状" Style="{StaticResource RowLabel}"/>
                    <ComboBox x:Name="RippleShapeBox" Grid.Column="1" Margin="0,0,8,0" Padding="8,3">
                        <ComboBoxItem Content="圆圈"/>
                        <ComboBoxItem Content="爱心"/>
                        <ComboBoxItem Content="星星"/>
                    </ComboBox>
                </Grid>

                <!-- 光圈大小 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="光圈大小" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="10" Maximum="120" Style="{StaticResource ModernSlider}"/>
                    <TextBlock x:Name="RadiusValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <!-- 光圈浓度 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="光圈浓度" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.05" Maximum="1"
                            SmallChange="0.05" LargeChange="0.1" Style="{StaticResource ModernSlider}"/>
                    <TextBlock x:Name="OpacityValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <!-- 涟漪大小 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="涟漪大小" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="RippleSlider" Grid.Column="1" Minimum="20" Maximum="150" Style="{StaticResource ModernSlider}"/>
                    <TextBlock x:Name="RippleValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <!-- 跟随速度 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="跟随速度" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="10" Maximum="200" Style="{StaticResource ModernSlider}"/>
                    <TextBlock x:Name="SpeedValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <Button x:Name="ClassicResetButton" Content="恢复默认" Style="{StaticResource SoftButton}"
                        HorizontalAlignment="Right" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <!-- 火屑参数 -->
        <Border x:Name="SparkPanel" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="火屑参数" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="拖动滑块立即生效，自动保存" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>

                <!-- 颜色 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="颜色" Style="{StaticResource RowLabel}"/>
                        <Rectangle x:Name="SparkColorPreview" Width="16" Height="16" RadiusX="4" RadiusY="4"
                                   Stroke="#D0D1D5" Margin="7,0,0,0"/>
                    </StackPanel>
                    <Slider x:Name="SparkHueSlider" Grid.Column="1" Minimum="0" Maximum="360" Style="{StaticResource ModernSlider}"/>
                    <TextBlock x:Name="SparkHueValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <!-- 粒子数量 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="粒子数量" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="SparkCountSlider" Grid.Column="1" Minimum="50" Maximum="600" Style="{StaticResource ModernSlider}"/>
                    <TextBlock x:Name="SparkCountValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <!-- 生命时长 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="生命时长" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="SparkLifeSlider" Grid.Column="1" Minimum="0.4" Maximum="2.5"
                            SmallChange="0.1" Style="{StaticResource ModernSlider}"/>
                    <TextBlock x:Name="SparkLifeValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <Button x:Name="SparkResetButton" Content="恢复默认" Style="{StaticResource SoftButton}"
                        HorizontalAlignment="Right" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <!-- 烟花参数 -->
        <Border x:Name="SparklerPanel" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="烟花参数" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="颜色固定为白炽色，无需设置" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>

                <!-- 粒子数量 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="粒子数量" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="SparklerCountSlider" Grid.Column="1" Minimum="100" Maximum="800" Style="{StaticResource ModernSlider}"/>
                    <TextBlock x:Name="SparklerCountValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <!-- 星芒直径 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="星芒直径" Style="{StaticResource RowLabel}"/>
                    <Slider x:Name="SparklerSizeSlider" Grid.Column="1" Minimum="80" Maximum="500" Style="{StaticResource ModernSlider}"/>
                    <TextBlock x:Name="SparklerSizeValue" Grid.Column="2" Style="{StaticResource RowValue}"/>
                </Grid>

                <Button x:Name="SparklerResetButton" Content="恢复默认" Style="{StaticResource SoftButton}"
                        HorizontalAlignment="Right" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
