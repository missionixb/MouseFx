<Window x:Class="MouseFx.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼠标特效设置" Width="380" Height="510"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FAFAFA">
    <StackPanel Margin="20,16,20,16">
        <!-- 特效模式 -->
        <TextBlock Text="特效模式" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
        <TextBlock Text="三种模式互相独立，同一时刻只启用一种" Foreground="#888" FontSize="11" Margin="0,0,0,6"/>
        <ComboBox x:Name="EffectModeBox" Margin="0,0,0,4" Padding="4,2">
            <ComboBoxItem Content="光圈 + 点击特效"/>
            <ComboBoxItem Content="火花"/>
            <ComboBoxItem Content="仙女棒"/>
        </ComboBox>
        <CheckBox x:Name="IdleFadeToggle" Content="静止时淡出（鼠标不动 2 秒后隐藏特效）" Margin="0,0,0,4"/>
        <CheckBox x:Name="FullscreenToggle" Content="全屏游戏时自动隐藏特效" Margin="0,0,0,4"/>
        <CheckBox x:Name="AutoStartToggle" Content="开机自启动" Margin="0,0,0,0"/>
        <Separator Margin="0,14,0,12"/>

        <!-- 经典特效参数（光圈 + 点击特效） -->
        <StackPanel x:Name="ClassicPanel">
            <TextBlock Text="特效参数（光圈 + 点击特效）" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
            <TextBlock Text="拖动滑块即时生效并自动保存" Foreground="#888" FontSize="11" Margin="0,0,0,10"/>

            <!-- 主题颜色 -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="主题颜色" VerticalAlignment="Center"/>
                    <Rectangle x:Name="ColorPreview" Width="18" Height="18" RadiusX="3" RadiusY="3"
                               Stroke="#999" Margin="8,0,0,0"/>
                </StackPanel>
                <Slider x:Name="HueSlider" Grid.Column="1" Minimum="0" Maximum="360" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                <TextBlock x:Name="HueValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 扩散形状 -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="扩散形状" VerticalAlignment="Center"/>
                <ComboBox x:Name="RippleShapeBox" Grid.Column="1" Margin="0,0,8,0" Padding="4,2"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="圆圈"/>
                    <ComboBoxItem Content="爱心"/>
                    <ComboBoxItem Content="星星"/>
                </ComboBox>
            </Grid>

            <!-- 光圈大小 -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="光圈大小" VerticalAlignment="Center"/>
                <Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="10" Maximum="120" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                <TextBlock x:Name="RadiusValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 光圈不透明度 -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="光圈不透明度" VerticalAlignment="Center"/>
                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.05" Maximum="1"
                        SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                <TextBlock x:Name="OpacityValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 点击扩散大小 -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="点击扩散大小" VerticalAlignment="Center"/>
                <Slider x:Name="RippleSlider" Grid.Column="1" Minimum="20" Maximum="150" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                <TextBlock x:Name="RippleValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 跟随速度 -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="跟随速度" VerticalAlignment="Center"/>
                <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="10" Maximum="200" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                <TextBlock x:Name="SpeedValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Button x:Name="ClassicResetButton" Content="恢复默认" HorizontalAlignment="Right"
                    Padding="12,3" FontSize="12" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- 火花参数 -->
        <StackPanel x:Name="SparkPanel" Visibility="Collapsed">
            <TextBlock Text="特效参数（火花）" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
            <TextBlock Text="拖动滑块即时生效并自动保存" Foreground="#888" FontSize="11" Margin="0,0,0,10"/>

            <!-- 火花颜色（与经典特效颜色分开保存） -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="火花颜色" VerticalAlignment="Center"/>
                    <Rectangle x:Name="SparkColorPreview" Width="18" Height="18" RadiusX="3" RadiusY="3"
                               Stroke="#999" Margin="8,0,0,0"/>
                </StackPanel>
                <Slider x:Name="SparkHueSlider" Grid.Column="1" Minimum="0" Maximum="360" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                <TextBlock x:Name="SparkHueValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 粒子数量 -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="粒子数量" VerticalAlignment="Center"/>
                <Slider x:Name="SparkCountSlider" Grid.Column="1" Minimum="50" Maximum="600" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="SparkCountValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 火花生命 -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="火花生命" VerticalAlignment="Center"/>
                <Slider x:Name="SparkLifeSlider" Grid.Column="1" Minimum="0.4" Maximum="2.5" SmallChange="0.1" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="SparkLifeValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Button x:Name="SparkResetButton" Content="恢复默认" HorizontalAlignment="Right"
                    Padding="12,3" FontSize="12" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- 仙女棒参数 -->
        <StackPanel x:Name="SparklerPanel" Visibility="Collapsed">
            <TextBlock Text="特效参数（仙女棒）" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
            <TextBlock Text="颜色固定为白炽色，无需设置" Foreground="#888" FontSize="11" Margin="0,0,0,10"/>

            <!-- 粒子数量 -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="粒子数量" VerticalAlignment="Center"/>
                <Slider x:Name="SparklerCountSlider" Grid.Column="1" Minimum="100" Maximum="800" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="SparklerCountValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 星芒直径 -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="星芒直径" VerticalAlignment="Center"/>
                <Slider x:Name="SparklerSizeSlider" Grid.Column="1" Minimum="80" Maximum="500" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="SparklerSizeValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Button x:Name="SparklerResetButton" Content="恢复默认" HorizontalAlignment="Right"
                    Padding="12,3" FontSize="12" Margin="0,10,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
