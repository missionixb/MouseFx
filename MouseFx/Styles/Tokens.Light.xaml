<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        设计 token（浅色主题）——对齐 Windows 11 设置应用 Fluent 视觉语言。
        键名与 Tokens.Dark.xaml 完全一致，主题切换时整本替换（App.xaml.cs ApplyThemeTokens）。
        因此所有主题相关引用必须用 DynamicResource。
    -->

    <!-- ==== 色板 ==== -->
    <SolidColorBrush x:Key="Bg.WindowBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Bg.CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.SubtleBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="Bg.SubtleHoverBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Bg.SubtlePressedBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Stroke.CardBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="Stroke.DividerBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="Text.PrimaryBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Text.SecondaryBrush" Color="#616161"/>
    <SolidColorBrush x:Key="Text.TertiaryBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Accent.DefaultBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="Accent.HoverBrush" Color="#1A86D9"/>
    <SolidColorBrush x:Key="Accent.PressedBrush" Color="#006CBF"/>
    <SolidColorBrush x:Key="Text.OnAccentBrush" Color="#FFFFFF"/>

    <!-- ==== 字体 ==== -->
    <FontFamily x:Key="Font.App">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <system:Double x:Key="FontSize.Title" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>
    <system:Double x:Key="FontSize.Body" xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>
    <system:Double x:Key="FontSize.Caption" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <FontWeight x:Key="FontWeight.BodyStrong">SemiBold</FontWeight>

    <!-- ==== 间距（4px 基数，统一为均匀 Thickness） ==== -->
    <Thickness x:Key="Space.XS">4</Thickness>
    <Thickness x:Key="Space.S">8</Thickness>
    <Thickness x:Key="Space.M">12</Thickness>
    <Thickness x:Key="Space.L">16</Thickness>
    <Thickness x:Key="Space.XL">20</Thickness>
    <Thickness x:Key="Space.XXL">28</Thickness>

    <!-- ==== 圆角 ==== -->
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Full">11</CornerRadius>

    <!-- ==== 文本样式 ==== -->
    <Style x:Key="AppTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyStrong}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.PrimaryBrush}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyStrong}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.PrimaryBrush}"/>
    </Style>

    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.SecondaryBrush}"/>
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.PrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ==== 卡片 ==== -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Stroke.CardBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Padding" Value="{StaticResource Space.L}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ==== 分段选择器项（模式切换，可拓展：项数由 EffectModeRegistry 驱动） ==== -->
    <Style x:Key="SegmentItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.SecondaryBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Radius.Control}"
                            Background="Transparent"
                            BorderBrush="{StaticResource Stroke.CardBrush}"
                            BorderThickness="0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.SubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.SubtlePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.CardBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{StaticResource Text.PrimaryBrush}"/>
                            <Setter TargetName="Cp" Property="TextBlock.FontWeight" Value="{StaticResource FontWeight.BodyStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== 带说明的双行开关行 ==== -->
    <Style x:Key="SwitchRow" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
